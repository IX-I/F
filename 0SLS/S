local foundPlayers = {}
local notifiedPlayers = {}
local function sendNotification(title, content, subContent)
    Fluent:Notify({
        Title = title or "INFO - Staff Detect",
        Content = content or "",
        SubContent = subContent or "",
        Duration = 65
    })
end
local function updateInServerNotification()
    if #foundPlayers > 0 then
        local playerList = table.concat(foundPlayers, ", ")
        sendNotification("INFO - Staff Detect", playerList, "In Server")
    end
end
local function checkStaffStatus(player)
    local entry = LeaderboardFrame:FindFirstChild("LeaderboardEntry["..player.Name.."]")
    if entry and entry:FindFirstChild("Username") and entry.Username:FindFirstChild("Staff") then
        if not table.find(foundPlayers, player.Name) then
            table.insert(foundPlayers, player.Name)
            if not table.find(notifiedPlayers, player.Name) then
                table.insert(notifiedPlayers, player.Name)
                sendNotification("INFO - Staff Detect", player.Name, "Staff Joined")
            end
            updateInServerNotification()
        end
    else
        for i, name in ipairs(foundPlayers) do
            if name == player.Name then
                table.remove(foundPlayers, i)
                if table.find(notifiedPlayers, player.Name) then
                    for j, n in ipairs(notifiedPlayers) do
                        if n == player.Name then
                            table.remove(notifiedPlayers, j)
                            sendNotification("INFO - Staff Detect", player.Name, "Left Staff")
                            break
                        end
                    end
                end
                updateInServerNotification()
                break
            end
        end
    end
end
local function monitorLeaderboard(player)
    local con
    con = LeaderboardFrame.ChildAdded:Connect(function(child)
        if child.Name == "LeaderboardEntry["..player.Name.."]" then
            checkStaffStatus(player)
        end
    end)
    LeaderboardFrame.ChildRemoved:Connect(function(child)
        if child.Name == "LeaderboardEntry["..player.Name.."]" then
            for i, name in ipairs(foundPlayers) do
                if name == player.Name then
                    table.remove(foundPlayers, i)
                    if table.find(notifiedPlayers, player.Name) then
                        for j, n in ipairs(notifiedPlayers) do
                            if n == player.Name then
                                table.remove(notifiedPlayers, j)
                                sendNotification("INFO - Staff Detect", player.Name, "Left Server")
                                break
                            end
                        end
                    end
                    updateInServerNotification()
                    break
                end
            end
        end
    end)
end
