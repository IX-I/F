local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local function initializeTauntData()
    local TauntsFolder = ReplicatedStorage.Assets.Items.Taunts
    local AllTauntNames = {}
    for _, taunt in pairs(TauntsFolder:GetChildren()) do
        table.insert(AllTauntNames, taunt.Name)
    end
    return AllTauntNames
end
local function getCurrentEquipped()
    local equippedRaw = LocalPlayer:GetAttribute("EquippedTaunts")
    if equippedRaw and equippedRaw ~= "" then
        local success, result = pcall(function()
            return HttpService:JSONDecode(equippedRaw)
        end)
        if success and typeof(result) == "table" then
            return result
        end
    end
    return {} 
end
local function convertSelection(input)
    local result = {}
    for k, v in pairs(input) do
        if typeof(k) == "string" and v == true then
            table.insert(result, k)
        elseif typeof(k) == "number" and typeof(v) == "string" then
            table.insert(result, v)
        end
    end
    return result
end
local function main()
    local AllTauntNames = initializeTauntData()
    local SelectedTaunts = {}
    local Active = false
    local SavedBeforeToggle = {}
    local initialEquipped = getCurrentEquipped()
    Active = #initialEquipped > 0
    SavedBeforeToggle = initialEquipped
    local initialSavedState = getCurrentEquipped()
    local DropdownRef = Tabs.all:AddDropdown("MultiDropdown", {
        Title = "Emote - (Max 4)",
        Description = "",
        Values = AllTauntNames,
        Multi = true,
        Default = initialEquipped,
        Callback = function() end 
    })
    Tabs.all:AddToggle("EnableTauntEquip", {
        Title = "Enable Emote",
        Description = "",
        Default = Active,
        Callback = function(state)
            Active = state
            if state then
                SavedBeforeToggle = getCurrentEquipped()
                if DropdownRef and DropdownRef.Value then
                    local selectedList = convertSelection(DropdownRef.Value)
                    if #selectedList <= 4 then
                        SelectedTaunts = selectedList
                        LocalPlayer:SetAttribute("EquippedTaunts", HttpService:JSONEncode(selectedList))
                    end
                end
            else
                local toRestore = initialSavedState or {}
                LocalPlayer:SetAttribute("EquippedTaunts", HttpService:JSONEncode(toRestore))
                SelectedTaunts = {}
                if DropdownRef then
                    DropdownRef:SetValue(toRestore)
                end
            end
        end
    })
    task.spawn(function()
        while true do
            task.wait(0.1)
            if Active and DropdownRef and DropdownRef.Value then
                local selectedList = convertSelection(DropdownRef.Value)
                if #selectedList <= 4 then
                    local encoded = HttpService:JSONEncode(selectedList)
                    if HttpService:JSONEncode(SelectedTaunts) ~= encoded then
                        SelectedTaunts = selectedList
                        LocalPlayer:SetAttribute("EquippedTaunts", encoded)
                    end
                end
            end
        end
    end)
    local function onCharacterAdded(character)
        task.wait(1) 
        if Active then
            if DropdownRef and DropdownRef.Value then
                local selectedList = convertSelection(DropdownRef.Value)
                if #selectedList <= 4 then
                    LocalPlayer:SetAttribute("EquippedTaunts", HttpService:JSONEncode(selectedList))
                end
            end
        else
            LocalPlayer:SetAttribute("EquippedTaunts", HttpService:JSONEncode(initialSavedState))
        end
    end
    LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
    if LocalPlayer.Character then
        onCharacterAdded(LocalPlayer.Character)
    end
end
