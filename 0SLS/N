function tryFix(func, maxTries)
    maxTries = maxTries or 3
    local tries = 0
    local success, result
    repeat
        success, result = pcall(func)
        if not success then
            warn("Error: " .. tostring(result) .. " | Attempt: " .. tries + 1)
            task.wait(1) 
        end
        tries = tries + 1
    until success or tries >= maxTries
    return success, result
end
